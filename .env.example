# ---------------------------------------------------------------------------
# Copie para .env (docker compose lê este arquivo automaticamente).
# Os valores abaixo funcionam com o docker-compose.yml deste repositório.
# ---------------------------------------------------------------------------

NODE_ENV=development

# HTTP
HTTP_PORT=3000

# PostgreSQL
DATABASE_URL=postgres://jungle:jungle@postgres:5432/jungle
DB_POOL_MIN=2
DB_POOL_MAX=10

# AWS / SQS (LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localstack:4566
SQS_WAGER_QUEUE_URL=http://localstack:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localstack:4566/000000000000/wager-transactions-dlq.fifo

# Nome lógico deste consumidor (chave do inbox: (consumerName, messageId))
CONSUMER_NAME=wager-processor

# Fila de saída dos eventos de integração (outbox worker)
SQS_WAGER_EVENTS_URL=http://localstack:4566/000000000000/wager-events.fifo
