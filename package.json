{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Serviço financeiro distribuído para processamento de transações de apostas",
  "type": "commonjs",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test src",
    "test:watch": "bun test src --watch",
    "test:int": "bun test test/integration",
    "test:int:up": "docker compose up -d postgres localstack && docker compose stop app",
    "test:all": "bun test src && bun test test/integration",
    "mikro-orm": "bun node_modules/@mikro-orm/cli/cli.js",
    "migration:create": "bun node_modules/@mikro-orm/cli/cli.js migration:create",
    "migration:up": "bun node_modules/@mikro-orm/cli/cli.js migration:up",
    "migration:down": "bun node_modules/@mikro-orm/cli/cli.js migration:down",
    "migration:pending": "bun node_modules/@mikro-orm/cli/cli.js migration:pending",
    "schema:fresh": "bun node_modules/@mikro-orm/cli/cli.js migration:fresh"
  },
  "mikro-orm": {
    "configPaths": ["./mikro-orm.config.ts"]
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.717.0",
    "@mikro-orm/core": "^6.4.2",
    "@mikro-orm/migrations": "^6.4.2",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@mikro-orm/cli": "^6.4.2",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.1.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "ajv": "^8.17.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
